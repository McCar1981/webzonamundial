    "@types/qrcode": "^1.5.6",
    "@types/web-push": "^3.6.4",
    "@vercel/kv": "^3.0.0",
    "flag-icons": "^7.5.0",
    "framer-motion": "^12.38.0",
    "gsap": "^3.14.2",
    "jose": "^6.2.1",
    "lucide-react": "^1.8.0",
    "next": "^14.2.0",
    "next-sanity": "^7.1.4",
    "nodemailer": "^8.0.5",
    "qrcode": "^1.5.4",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "stripe": "^22.1.0",
    "three": "^0.161.0",
    "web-push": "^3.6.7"
  },
